DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=example.com
DATABASE_URL=postgres://opuscule:replace-me@127.0.0.1:5432/opuscule
SSR_PORT=5175
API_BASE=http://127.0.0.1:8000/api

# 仅当服务位于可信反向代理之后时开启；直连开启可被伪造 X-Forwarded-For。
TRUST_PROXY_HEADERS=0
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=1
DJANGO_TRUST_PROXY_SSL=1
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_SMTP_HOST=smtp.example.com
DJANGO_SMTP_PORT=587
DJANGO_SMTP_USERNAME=replace-me
DJANGO_SMTP_PASSWORD=replace-me
DJANGO_SMTP_USE_TLS=1
