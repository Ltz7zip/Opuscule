# Replace example.com and certificate paths before use.
# This config is a sketch; it has not been executed in this environment.
upstream opuscule_api {
    server 127.0.0.1:8000;
}
upstream opuscule_web {
    server 127.0.0.1:5175;
}

server {
    listen 80;
    server_name example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name example.com;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;

    client_max_body_size 21m;

    location /media/ {
        alias /srv/opuscule/media/;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    location = /healthz {
        proxy_pass http://opuscule_web;
        proxy_set_header Host $host;
    }

    location /assets/ {
        proxy_pass http://opuscule_web;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /feed.xml {
        proxy_pass http://opuscule_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/w/[^/]+/feed\.xml$ {
        proxy_pass http://opuscule_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://opuscule_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /admin/ {
        proxy_pass http://opuscule_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /static/ {
        proxy_pass http://opuscule_api;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /share/ {
        proxy_pass http://opuscule_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /robots.txt {
        proxy_pass http://opuscule_api;
    }

    location = /sitemap.xml {
        proxy_pass http://opuscule_api;
    }

    location / {
        proxy_pass http://opuscule_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
