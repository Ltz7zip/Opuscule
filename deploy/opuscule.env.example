# 复制到 /etc/opuscule.env，逐项改成真实值，然后 chown root:ubuntu && chmod 640。
# 这些变量由 worldbuilding_timeline/settings.py 读取。

# 必改：换成一串足够长的随机字符串。生成示例：
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# 对外服务必须为 0（关掉调试页，否则会泄露源码/配置/SQL）
DJANGO_DEBUG=0

# 你的域名（逗号分隔，不带协议）
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# CSRF 信任来源（逗号分隔，带 https:// ；登录/注册表单需要）
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# 过渡开关：域名/证书还没就绪、只能拿公网 IP 明文 HTTP 对外时置 1。
# 它会跳过 Secure Cookie、强制跳转 HTTPS、HSTS 这三项硬性要求（见 settings.py）。
# **证书签好后必须删掉这一行**——留着等于让口令和会话 Cookie 在公网明文传输。
# OPUSCULE_INSECURE_HTTP=1

# 后台路径：默认 admin 只为方便本地开发；对外服务应改成一串猜不到的值，
# 让扫描器按默认 /admin/ 找不到入口（详见 docs/13-部署与运维.md §3.6）。
# OPUSCULE_ADMIN_PATH=ops-7f3a9c

# 另存一份应用日志到文件（可选）。设了会按大小自动轮转（单文件 10 MB × 5 份，
# 无需 logrotate）；不设则只进 journald（详见 docs/13-部署与运维.md §3.7 / §8.6）。
# 记得先建好目录并给运行用户写权限：sudo mkdir -p /var/log/opuscule
# OPUSCULE_LOG_FILE=/var/log/opuscule/app.log

# 后台两步验证里，认证器 App 显示的组织名（详见 docs/13-部署与运维.md §3.9 / §4.11）。
# 不设则只显示用户名，容易跟别的站混在一起；建议改成站点名。
# OPUSCULE_OTP_ISSUER=Opuscule

# 维护模式：置 1 全站打烊（返回 503 + 维护页，详见 world/maintenance.py）
# OPUSCULE_MAINTENANCE=1
# OPUSCULE_MAINTENANCE_ETA=预计 15 分钟后恢复

# ── 备份（deploy/backup.sh 读取；详见 docs/13-部署与运维.md §7）──────────────
# 必填：age 公钥（形如 age1...）。只放公钥，私钥离线保管——服务器被偷也解不开备份。
# 生成密钥对：age-keygen -o backup.key    # backup.key 是私钥，存离线，丢了备份就废了
BACKUP_AGE_RECIPIENT=age1change-me-to-your-public-key

# 异地目标（rclone 远端）。不填就只留本机——机器挂了备份也没了，生产上别这么干。
# 例：oss:opuscule-backup/   s3:bucket/opuscule/   sftp:host/backups/
# BACKUP_RCLONE_REMOTE=oss:opuscule-backup/

# 本机存放目录与保留天数（可省略，默认如下）
# BACKUP_DIR=/var/backups/opuscule
# KEEP_DAYS=14
