{
  "name": "opuscule-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:budget": "node scripts/check-budget.mjs",
    "dev:ssr": "node server.mjs",
    "build:ssr": "vite build --ssr src/ssr/entry-server.tsx --outDir dist-ssr",
    "build:all": "npm run build && npm run build:ssr",
    "preview:ssr": "node server.prod.mjs",
    "ui:snapshots": "playwright test",
    "ui:snapshots:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-drag-handle": "^3.32.0",
    "@tiptap/extension-drag-handle-react": "^3.32.0",
    "@tiptap/extension-mention": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-table-cell": "^3.32.0",
    "@tiptap/extension-table-header": "^3.32.0",
    "@tiptap/extension-table-row": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
